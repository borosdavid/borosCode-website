{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boroscode-website",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/otthontar",
      "/otthontar/*"
    ]
  },
  "main": "src/worker.js"
}
